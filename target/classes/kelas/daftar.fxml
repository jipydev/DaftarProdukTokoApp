<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="600.0" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Daftar Produk Toko" />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <TextField fx:id="txtCari" promptText="Cari nama produk..." HBox.hgrow="ALWAYS" />
                <Button onAction="#handleCari" text="Cari" />
            </children>
        </HBox>
        <TableView fx:id="tableProduk" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colKode" prefWidth="100.0" text="Kode" />
                <TableColumn fx:id="colNama" prefWidth="200.0" text="Nama Produk" />
                <TableColumn fx:id="colKategori" prefWidth="120.0" text="Kategori" />
                <TableColumn fx:id="colHarga" prefWidth="130.0" text="Harga" />
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="12.0">
            <children>
                <Button onAction="#handleLihatDetail" text="Lihat Detail" />
                <Button onAction="#handleTambahBaru" text="Tambah Produk" />
            </children>
        </HBox>
    </children>
</VBox>